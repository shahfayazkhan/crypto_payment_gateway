# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_EXPIRES_IN=12h

# Run the background workers inside the API process (handy for local dev).
# In production set to false and run `npm run worker` as its own process.
RUN_WORKERS_IN_API=true

# ─── Infra ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/crypto_gateway?replicaSet=rs0&directConnection=true
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# ─── Modes ──────────────────────────────────────────────
# mock  = built-in chain simulator (no RPC, no real funds) — default for testing
# live  = real RPC adapters (testnets first!)
CHAIN_MODE=mock
# mock = in-DB MT5 accounts; bridge = your .NET MT5 Bridge over HTTP
MT5_MODE=mock
MT5_BRIDGE_URL=http://localhost:5080
MT5_BRIDGE_API_KEY=
# mock = random-walk prices; coingecko = public CoinGecko API
PRICE_MODE=mock

# Mock simulator speed multiplier (2 = blocks twice as fast)
MOCK_SPEED=1
# Generate random deposits/withdrawals automatically on boot
MOCK_AUTO_TRAFFIC=false
MOCK_TRAFFIC_INTERVAL_MS=8000

# ─── Keys (DEV ONLY) ────────────────────────────────────
# The signer derives hot-wallet keys and Solana deposit addresses from this.
# In production this lives ONLY inside the isolated signer service / HSM.
MASTER_MNEMONIC=test test test test test test test test test test test junk
BTC_NETWORK=testnet

# Cold wallets (watch-only, keys never touch this server)
COLD_WALLET_TRON=TPL66VK2gCXNCD7EJg9pgJRfqcRazjhUZY
COLD_WALLET_ETH=0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed
COLD_WALLET_BSC=0x5aAeb6053F3E94C9b9A09f33669435E7Ef1BeAed
COLD_WALLET_BTC=tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx
COLD_WALLET_SOL=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

# ─── Live RPC (only used when CHAIN_MODE=live) ──────────
ETH_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BSC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
TRON_API_URL=https://nile.trongrid.io
TRON_API_KEY=
BTC_ESPLORA_URL=https://blockstream.info/testnet/api
SOL_RPC_URL=https://api.devnet.solana.com
USDT_ERC20_CONTRACT=0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
USDT_BEP20_CONTRACT=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
USDT_TRC20_CONTRACT=TXYZopYRdj2D9XRtbG411XZZ3kM5VkAeBf

# ─── Treasury policy ────────────────────────────────────
SWEEP_INTERVAL_MS=30000
# Keep hot wallets topped up to this USD value; anything above goes to cold
HOT_WALLET_TARGET_USD=25000
WITHDRAWAL_AUTO_APPROVE_USD=0
WITHDRAWAL_DAILY_LIMIT_USD=50000

# ─── Outbound webhooks (CRM / RMS) ──────────────────────
# Comma-separated. Default points at the built-in sink so you can watch events.
WEBHOOK_URLS=http://localhost:4000/api/dev/webhook-sink
WEBHOOK_SECRET=whsec_dev_change_me
